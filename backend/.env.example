# Copy this file to .env and fill in real values for your environment.
# NEVER commit the real .env file to GitHub.

# --- Database ---
# Local development default (SQLite file, relative to backend/):
DATABASE_URL=sqlite:///./flutestar.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://flutestar_user:REPLACE_ME@db-host:5432/flutestar

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Local development:
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Production (must be the exact scheme+host, no trailing slash, no wildcard):
# ALLOWED_ORIGINS=https://employer.flute-star.com
